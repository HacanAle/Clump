{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clump",
  "version": "1.3.1",
  "identifier": "com.clump.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Clump",
        "url": "index.html",
        "width": 388,
        "height": 520,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
